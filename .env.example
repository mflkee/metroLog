# Application
APP_ENV=development
APP_NAME=metroLog
SECRET_KEY=change-me-in-production

# Bootstrap admin (created on first run if no users exist)
BOOTSTRAP_ADMIN_FIRST_NAME=Admin
BOOTSTRAP_ADMIN_LAST_NAME=User
BOOTSTRAP_ADMIN_PATRONYMIC=
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123

# Frontend URL (for CORS and email links)
FRONTEND_APP_URL=http://localhost:5173

# Single sign-on (Authentik OIDC). Off unless OIDC_ENABLED=true and a secret is set.
OIDC_ENABLED=false
OIDC_ISSUER=https://auth.mkair-it.ru/application/o/metrolog/
OIDC_CLIENT_ID=metrolog
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://metrolog.mkair-it.ru/api/v1/auth/oidc/callback
OIDC_SCOPES=openid email profile groups
OIDC_AUTO_PROVISION=false
OIDC_COOKIE_SECURE=true

# Ports
BACKEND_PORT=8000
BACKEND_WORKERS=2
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379

# Database
POSTGRES_DB=metrolog
POSTGRES_USER=metrolog
POSTGRES_PASSWORD=metrolog
DATABASE_URL=postgresql+psycopg://metrolog:metrolog@postgres:5432/metrolog

# Redis
REDIS_URL=redis://redis:6379/0

# CORS
BACKEND_CORS_ORIGINS=http://localhost:5173

# Frontend build
VITE_API_BASE_URL=/api/v1

# File uploads
UPLOAD_MAX_FILE_SIZE_BYTES=25000000
ATTACHMENT_IMAGE_TARGET_SIZE_BYTES=2000000
ATTACHMENT_IMAGE_MAX_DIMENSION_PIXELS=2560

# Notifications
NOTIFICATION_QUEUE_ENABLED=true
MENTION_NOTIFICATIONS_ENABLED=true

# SMTP (optional — required for email notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=metroLog
